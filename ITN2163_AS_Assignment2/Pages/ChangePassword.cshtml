@page
@model ITN2163_AS_Assignment2.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<h2>@ViewData["Title"]</h2>

<form method="post" id="changePasswordForm">
    <div class="form-group">
        <label asp-for="Input.CurrentPassword"></label>
        <input type="text" asp-for="Input.CurrentPassword" class="form-control" />
        <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Input.NewPassword"></label>
        <input type="text" asp-for="Input.NewPassword" class="form-control" onkeyup="validatePassword()"/>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Input.ConfirmPassword"></label>
        <input type="text" asp-for="Input.ConfirmPassword" class="form-control" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <div>
        <button type="submit" class="btn btn-primary" onclick="clearFields()">Change Password</button>
    </div>
</form>

<script type="text/javascript">
    function validatePassword() {
        var pwd = document.getElementById("password").value;
        var message = document.getElementById("lbl_pwdchecker");

        // Check for minimum length
        if (pwd.length < 12) {
            message.innerHTML = "Password must be at least 12 characters.";
            message.style.color = "red";
            return;
        }

        // Regular expressions to check for lowercase, uppercase, digit and special character
        var lowercase = /[a-z]/;
        var uppercase = /[A-Z]/;
        var number = /[0-9]/;
        var specialCharacter = /[\W_]/; // Matches any non-word character

        if (!lowercase.test(pwd)) {
            message.innerHTML = "Password must include at least one lowercase letter.";
            message.style.color = "red";
            return;
        }
        if (!uppercase.test(pwd)) {
            message.innerHTML = "Password must include at least one uppercase letter.";
            message.style.color = "red";
            return;
        }
        if (!number.test(pwd)) {
            message.innerHTML = "Password must include at least one number.";
            message.style.color = "red";
            return;
        }
        if (!specialCharacter.test(pwd)) {
            message.innerHTML = "Password must include at least one special character.";
            message.style.color = "red";
            return;
        }

        message.innerHTML = "Strong password!";
        message.style.color = "green";
    }
</script>